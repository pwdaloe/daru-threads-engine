# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Database - Supabase transaction pooler for Prisma Client
# If you use the pooler on port 6543, add ?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Optional: Direct database URL for Prisma CLI commands like migrate/db push
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# OpenAI API - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# JWT Secret - Generate a secure random string (you can use: openssl rand -hex 32)
JWT_SECRET="your-secure-jwt-secret-here"

# Optional: OpenAI Model (default: gpt-3.5-turbo)
# OPENAI_MODEL="gpt-4"
