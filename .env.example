# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database - Get from Supabase Dashboard > Settings > Database
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# OpenAI API - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# JWT Secret - Generate a secure random string (you can use: openssl rand -hex 32)
JWT_SECRET="your-secure-jwt-secret-here"

# Optional: OpenAI Model (default: gpt-3.5-turbo)
# OPENAI_MODEL="gpt-4"